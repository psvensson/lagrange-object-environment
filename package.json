{
  "name": "lagrange-object-environment",
  "version": "0.0.0",
  "description": "Live object computing environment for Lagrange Images",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=120000 test/browser/browser-proof.test.js test/browser/glb-proof.test.js test/browser/intent-proof.test.js test/browser/dom-coexistence.test.js",
    "test:browser:canvas": "node --test test/browser/browser-proof.canvas.manual.test.js",
    "beads:init": "bd init --quiet --skip-agents",
    "beads:prime": "bd prime",
    "beads:ready": "bd ready --json",
    "beads:doctor": "bd doctor"
  },
  "devDependencies": {
    "@beads/bd": "1.2.2",
    "puppeteer-core": "25.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@wasi-gfx/wasi-gfx-shim": "0.1.0"
  }
}
