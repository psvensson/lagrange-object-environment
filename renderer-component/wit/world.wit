package lagrange:glb-renderer;

/// The WIT world for the Lagrange GLB renderer Component. Same graphics/surface
/// imports as the wasi-gfx examples (the Component renders through
/// wasi:webgpu + wasi-gfx:surface), PLUS the lagrange:assets provider import so
/// durable GLB bytes cross the host -> Component boundary at runtime.
world glb-renderer {
    include wasi:webgpu/imports@0.3.0-rc.2;
    include wasi-gfx:surface/webgpu-imports@0.2.0;

    /// main entrypoint
    export start: async func();

    /// print to stdout (debug output, no semantics)
    import print: func(s: string);

    /// durable asset bytes, loaded at runtime
    import lagrange:assets/provider@0.1.0;
}
